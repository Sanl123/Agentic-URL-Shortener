{
  "_comment": "Copy relevant sections into src/UrlShortener.Api/appsettings.Development.json or appsettings.Production.json. Never commit real secrets.",
  "ConnectionStrings": {
    "UrlShortenerDb": "Server=(localdb)\\mssqllocaldb;Database=UrlShortenerDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "urlshortener-api",
    "Audience": "urlshortener-clients",
    "SigningKey": "NEVER COMMIT A REAL KEY HERE - use `dotnet user-secrets` locally or an environment variable/secret manager in production. Must be >= 32 bytes.",
    "ClockSkewSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ShortCode": {
    "Length": 7,
    "Alphabet": "23456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ",
    "MaxGenerationAttempts": 5
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}
