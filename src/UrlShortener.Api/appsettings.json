{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "UrlShortenerDb": ""
  },
  "Jwt": {
    "Issuer": "urlshortener-api",
    "Audience": "urlshortener-clients",
    "SigningKey": "",
    "ClockSkewSeconds": 30
  },
  "ShortCode": {
    "Length": 7,
    "Alphabet": "23456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ",
    "MaxGenerationAttempts": 5
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },
  "AllowedHosts": "*"
}
