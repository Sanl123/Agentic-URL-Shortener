{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "UrlShortenerDb": "Server=(localdb)\\mssqllocaldb;Database=UrlShortenerDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "urlshortener-api",
    "Audience": "urlshortener-clients",
    "_comment": "SigningKey intentionally omitted here - set it via `dotnet user-secrets set \"Jwt:SigningKey\" \"<your-own-32+ byte random value>\"` from src/UrlShortener.Api. See docs/decisions.md.",
    "ClockSkewSeconds": 30
  },
  "ShortCode": {
    "Length": 7,
    "Alphabet": "23456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ",
    "MaxGenerationAttempts": 5
  },
  "RateLimiting": {
    "PermitLimit": 60,
    "WindowSeconds": 60,
    "QueueLimit": 0
  }
}
